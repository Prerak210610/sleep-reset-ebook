rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.superadmin == true || request.auth.token.admin == true);
    }

    // All marketing assets are public-read
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
